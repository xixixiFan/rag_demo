# ============================================
# RAG 项目环境配置模板
# ============================================
# 使用方法：复制此文件为 .env，然后填写实际值
# 不要提交 .env 文件到 git，.env.example 可以提交

# ============================================
# 1. AI 模型配置（必须）
# ============================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=text-embedding-3-small
DEEPSEEK_TIMEOUT=30000

# 智谱 GLM（可选）
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_CHAT_MODEL=glm-4

# ============================================
# 2. Web Search 配置（可选）
# ============================================
TAVILY_API_KEY=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
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=3
TAVILY_TIMEOUT=10000

# ============================================
# 3. Redis 缓存配置
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# 4. ChromaDB 向量数据库配置
# ============================================
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false

# ============================================
# 5. RAG 配置
# ============================================
RAG_TOP_K=10                    # 向量检索返回 Top-K
RAG_RERANK_TOP_K=3              # 重排后保留 Top-K
RAG_SIMILARITY_THRESHOLD=0.55   # 相似度阈值
RAG_CHUNK_SIZE=512              # 文本切片大小
RAG_CHUNK_OVERLAP=50            # 切片重叠大小

# ============================================
# 6. 记忆管理配置
# ============================================
MEMORY_STRATEGY=window          # 'window' 或 'summary'
MEMORY_WINDOW_SIZE=6            # 滑动窗口大小
MEMORY_MAX_TOKENS=4000          # 最大 token 数

# ============================================
# 7. LangGraph 配置（r3 使用）
# ============================================
LANGGRAPH_CHECKPOINTER=memory   # 'memory' 或 'sqlite'
LANGGRAPH_THREADS_ENABLED=true

# ============================================
# 8. 项目配置
# ============================================
NODE_ENV=development
DEBUG=false
